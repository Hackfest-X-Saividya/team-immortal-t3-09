# =================================================================
# CarbonIQ Backend Environment Configuration (.env.example)
# Copy this file to .env and customize values for your deployment.
# =================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=carboniq_db

# JWT Authentication
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=your-32-byte-secret-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Official Groq API Configuration (FastAPI Backend Only - Never expose in frontend)
# Get your API key at: https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Pretrained ML Emission Trend Model
ML_MODEL_PATH=app/models/emission_trend_model.joblib
ML_METADATA_PATH=app/models/model_metadata.json
